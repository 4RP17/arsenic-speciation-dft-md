! PBE0 D4 def2-TZVP TightSCF CPCM(Water) NMR

%pal
  nprocs 4
end

%maxcore 3000

%eprnmr
  Nuclei = all As {shift}
end

# Replace charge/multiplicity and xyz filename after your Opt/Freq job finishes.
# Examples:
# * xyzfile 0 1 01_H3AsO3_AsIII_fast_optfreq.xyz
# * xyzfile -1 1 02_H2AsO4_AsV_fast_optfreq.xyz
# * xyzfile -2 1 03_HAsO4_AsV_fast_optfreq.xyz

* xyzfile 0 1 optimized_structure.xyz
